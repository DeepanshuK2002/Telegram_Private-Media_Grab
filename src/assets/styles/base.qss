/* base.qss — shadcn-style semantic theme, rendered by ui/theme.py */

* {
    color: {foreground};
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    outline: none;
}

QToolTip {
    background-color: {popover};
    color: {foreground};
    border: 1px solid {border};
    padding: 6px 10px;
    border-radius: 6px;
    font-size: 12px;
}

QMenu {
    background-color: {card};
    border: 1px solid {border};
    border-radius: 8px;
    padding: 4px;
    color: {foreground};
}

QMenu::item {
    background-color: transparent;
    padding: 6px 20px;
    border-radius: 4px;
    color: {foreground};
    font-size: 12px;
}

QMenu::item:selected {
    background-color: {muted};
    color: {primary};
}

QMenu::separator {
    height: 1px;
    background: {border};
    margin: 4px 6px;
}

/* ── Application Backgrounds ─────────────────────────────────────────────── */

QMainWindow, QWidget#CentralWidget {
    background-color: {background};
    color: {foreground};
}

QScrollArea, QScrollArea > QWidget > QWidget {
    background-color: transparent;
    border: none;
}

/* ── Sidebar Navigation ──────────────────────────────────────────────────── */

QWidget#Sidebar {
    background-color: {primary_foreground};
    border: none;
    border-right: 1px solid {border};
}

QWidget#Sidebar QToolButton {
    background-color: transparent;
    color: {muted_fg_static};
    border: 1px solid transparent;
    text-align: center;
    padding: 7px 1px;
    font-size: 10px;
    font-weight: 500;
    border-radius: 6px;
    margin: 2px 2px;
}

QWidget#Sidebar QToolButton:hover {
    color: {foreground};
    background-color: {muted};
}

QWidget#Sidebar QToolButton:checked {
    background-color: {muted};
    border: 1px solid {border};
    color: {primary};
}

/* ── Typography & Headers ────────────────────────────────────────────────── */

QLabel {
    color: {foreground};
}

QLabel#MainHeader {
    color: {foreground_inverse};
    font-weight: 600;
    font-size: 18px;
}

QLabel#MainHeaderLarge {
    color: {foreground_inverse};
    font-weight: 600;
    font-size: 22px;
}

QLabel#SectionHeader {
    font-size: 14px;
    font-weight: 600;
    color: {foreground_inverse};
}

QLabel#ControlLabel {
    font-size: 12px;
    font-weight: 500;
    color: {subtle_foreground};
}

QLabel#MutedText {
    color: {muted_fg_static};
    font-size: 12px;
}

QLabel#DescriptionText {
    color: {subtle_foreground};
    font-size: 13px;
}

/* ── Cards & Containers ─────────────────────────────────────────────────── */

QWidget#WhiteCard, QFrame#WhiteCard {
    background-color: {card};
    border: 1px solid {border};
    border-radius: 8px;
}

QWidget#WhiteCard:hover, QFrame#WhiteCard:hover {
    border-color: {border_strong};
}

QFrame#DangerCard {
    background-color: {card};
    border: 1px solid {destructive_surface};
    border-radius: 8px;
}

QFrame#DangerCard:hover {
    border-color: {destructive_border};
}

/* ── Known Channels Rows ─────────────────────────────────────────────────── */

QFrame#ChannelRow {
    background-color: {surface_alt};
    border: 1px solid {border};
    border-radius: 8px;
}

QFrame#ChannelRow:hover {
    background-color: {surface_subtle};
    border-color: {border_strong};
}

QLabel#ChannelRowName {
    color: {foreground};
    font-size: 13px;
    font-weight: 600;
}

QLabel#ChannelRowSub {
    color: {muted_foreground};
    font-size: 11px;
    font-weight: 400;
}

QLabel#ChannelRowID {
    color: {muted_fg_static};
    font-size: 12px;
    font-family: "Consolas", "Courier New", monospace;
    background-color: transparent;
    border: none;
    padding: 0px 4px;
}

QLabel#ChannelRowID:hover {
    color: {surface_fg_inv};
    background-color: transparent;
    border: none;
}

QLabel#ChannelsCountBadge {
    font-size: 12px;
    font-weight: 500;
    color: {muted_fg_static};
    background-color: transparent;
    border: none;
    padding: 0px;
}



QFrame#EmptyChannelsState {
    background-color: {surface_alt_fa};
    border: 1px dashed {border};
    border-radius: 8px;
    padding: 20px 16px;
}

/* ── Buttons ─────────────────────────────────────────────────────────────── */

/* Primary Button: Vercel inverted pitch-black in light mode */
QPushButton#PrimaryButton, 
QPushButton#PrimaryButtonLarge, 
QPushButton#VercelButton, 
QPushButton#SuccessButton {
    background-color: {primary};
    color: {primary_foreground};
    border: 1px solid transparent;
    border-radius: 6px;
    font-weight: 500;
    font-size: 13px;
    padding: 0 16px;
    min-height: 38px;
}

QPushButton#PrimaryButton:hover, 
QPushButton#PrimaryButtonLarge:hover, 
QPushButton#VercelButton:hover, 
QPushButton#SuccessButton:hover {
    background-color: {border_inverse};
}

QPushButton#PrimaryButton:pressed, 
QPushButton#PrimaryButtonLarge:pressed, 
QPushButton#VercelButton:pressed, 
QPushButton#SuccessButton:pressed {
    background-color: {border_inverse2};
}

QPushButton#PrimaryButton:disabled, 
QPushButton#PrimaryButtonLarge:disabled, 
QPushButton#VercelButton:disabled, 
QPushButton#SuccessButton:disabled {
    background-color: {muted_alt};
    color: {scrollbar_pressed};
    border-color: transparent;
}

/* Secondary Button: Clean light zinc outline */
QPushButton#SecondaryButton, 
QPushButton#CardButton, 
QPushButton#PrimaryRowButton,
QPushButton#VercelOAuthButton {
    background-color: {card};
    color: {foreground};
    border: 1px solid {border};
    border-radius: 6px;
    font-weight: 500;
    font-size: 13px;
    padding: 0 14px;
    min-height: 36px;
}

QPushButton#SecondaryButton:hover, 
QPushButton#CardButton:hover, 
QPushButton#PrimaryRowButton:hover,
QPushButton#VercelOAuthButton:hover {
    background-color: {muted};
    border-color: {border_strong};
    color: {primary};
}

QPushButton#SecondaryButton:pressed, 
QPushButton#CardButton:pressed, 
QPushButton#PrimaryRowButton:pressed,
QPushButton#VercelOAuthButton:pressed {
    background-color: {border};
}

QPushButton#SecondaryButton:disabled, 
QPushButton#CardButton:disabled, 
QPushButton#PrimaryRowButton:disabled {
    background-color: {card};
    color: {scrollbar};
    border-color: {muted};
}

/* Icon-only Button (e.g. Refresh, Action Icons) */
QPushButton#IconButton {
    background-color: {card};
    border: 1px solid {border};
    border-radius: 6px;
    padding: 0px;
    min-width: 36px;
    max-width: 36px;
    min-height: 36px;
    max-height: 36px;
}

QPushButton#IconButton:hover {
    background-color: {muted};
    border-color: {border_strong};
}

QPushButton#IconButton:pressed {
    background-color: {border};
}

QPushButton#IconButton:disabled {
    background-color: {card};
    border-color: {muted_alt};
}

QPushButton#IconButtonSmall {
    background-color: {card};
    border: 1px solid {border};
    border-radius: 6px;
    padding: 0px;
    min-width: 30px;
    max-width: 30px;
    min-height: 30px;
    max-height: 30px;
}

QPushButton#IconButtonSmall:hover {
    background-color: {muted};
    border-color: {border_strong};
}

QPushButton#IconButtonSmall:pressed {
    background-color: {border};
}

QPushButton#IconButtonSmall:disabled {
    background-color: {card};
    border-color: {muted_alt};
}

/* Compact Card Buttons */
QPushButton#CardButtonCompact {
    background-color: {card};
    border: 1px solid {border};
    border-radius: 5px;
    color: {foreground};
    font-size: 11px;
    font-weight: 500;
    padding: 0px 6px;
    min-height: 22px;
}

QPushButton#CardButtonCompact:hover {
    background-color: {muted};
    border-color: {border_strong};
    color: {primary};
}

QPushButton#CardButtonCompactDanger {
    background-color: transparent;
    border: 1px solid {destructive_ring};
    border-radius: 5px;
    color: {destructive_solid};
    font-size: 11px;
    font-weight: 500;
    padding: 0px 6px;
    min-height: 22px;
}

QPushButton#CardButtonCompactDanger:hover {
    background-color: {destructive_ring_hover};
    border-color: {destructive_solid};
    color: {destructive_fg};
}

/* Destructive / Danger Button */
QPushButton#LogoutBtn {
    background-color: {card};
    color: {destructive_const};
    border: 1px solid {destructive_border};
    border-radius: 6px;
    font-weight: 500;
    font-size: 13px;
    padding: 0 14px;
    min-height: 36px;
}

QPushButton#LogoutBtn:hover {
    background-color: {destructive_hover};
    border-color: {destructive_solid};
    color: {destructive_fg};
}

QPushButton#LogoutBtn:pressed {
    background-color: {destructive_surface_pressed};
    border-color: {destructive_solid};
    color: {destructive_fg2};
}

/* Danger Ghost Button: Vercel Destructive Outline */
QPushButton#DangerGhostButton {
    background-color: transparent;
    color: {destructive_fg};
    border: 1px solid {destructive_ring};
    border-radius: 6px;
    font-weight: 500;
    font-size: 13px;
    padding: 0 14px;
    min-height: 36px;
}

QPushButton#DangerGhostButton:hover {
    background-color: {destructive_ring_hover};
    border-color: {destructive_solid};
    color: {destructive_solid};
}

QPushButton#DangerGhostButton:pressed {
    background-color: {destructive_ring_active};
}

QPushButton#DangerGhostButton:disabled {
    background-color: transparent;
    color: {scrollbar};
    border-color: {border};
}

/* Expand / Link Buttons */
QPushButton#ExpandButton {
    color: {muted_foreground};
    font-weight: 500;
    font-size: 12px;
    background: transparent;
    border: none;
    padding: 4px 8px;
}

QPushButton#ExpandButton:hover {
    color: {foreground_inverse};
}

QPushButton#LinkButton {
    background: transparent;
    border: none;
    color: {foreground};
    font-weight: 500;
    text-align: left;
}

QPushButton#LinkButton:hover {
    color: {primary};
    text-decoration: underline;
}

/* ── Form Inputs ─────────────────────────────────────────────────────────── */

QLineEdit, QSpinBox, QLineEdit#VercelInput {
    background-color: {card};
    border: 1px solid {border};
    border-radius: 6px;
    color: {foreground_inverse};
    padding: 8px 12px;
    font-size: 13px;
    selection-background-color: {muted_alt};
    selection-color: {primary};
}

QLineEdit:hover, QSpinBox:hover, QLineEdit#VercelInput:hover {
    border-color: {border_strong};
}

QLineEdit:focus, QSpinBox:focus, QLineEdit#VercelInput:focus {
    border-color: {muted_fg_static};
    background-color: {card};
}

/* ── Date Pickers & Calendars (Light) ────────────────────────────────────── */

QDateEdit {
    background-color: {surface_alt};
    border: 1px solid {border};
    border-radius: 6px;
    color: {foreground};
    padding: 4px 10px;
    font-size: 12px;
    font-weight: 500;
    min-height: 34px;
    selection-background-color: {muted_alt};
    selection-color: {primary};
}

QDateEdit:hover {
    border-color: {border_strong};
}

QDateEdit:focus {
    border-color: {muted_foreground};
    background-color: {popover};
}

QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 28px;
    border-left: 1px solid {border};
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: {muted};
}

QDateEdit::drop-down:hover {
    background-color: {border};
}

QDateEdit::down-arrow {
    image: url(@ICONS_DIR@/{icon_chevron});
    width: 10px;
    height: 10px;
}

QCalendarWidget {
    background-color: {surface_alt};
    border: 1px solid {border};
    border-radius: 8px;
}

QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: {muted};
    border-bottom: 1px solid {border};
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    min-height: 38px;
}

QCalendarWidget QToolButton {
    color: {foreground};
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    margin: 2px 4px;
    padding: 4px 8px;
    font-size: 12px;
    font-weight: 600;
}

QCalendarWidget QToolButton:hover {
    background-color: {border};
    border-color: {border_strong};
}

QCalendarWidget QToolButton:pressed {
    background-color: {border_strong};
}

QCalendarWidget QSpinBox {
    color: {foreground};
    background-color: {surface_alt};
    border: 1px solid {border};
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 12px;
}

QCalendarWidget QTableView {
    background-color: {surface_alt};
    selection-background-color: {primary};
    selection-color: {primary_foreground};
    color: {foreground};
    border: none;
    outline: none;
}

QCalendarWidget QHeaderView::section {
    background-color: {muted};
    color: {muted_foreground};
    border: none;
    padding: 4px;
    font-size: 11px;
    font-weight: 600;
}

/* ── Known Channels Header Controls ───────────────────────────────────────── */

QLineEdit#KnownChannelInput {
    background-color: {card};
    border: 1px solid {border};
    border-radius: 6px;
    color: {foreground};
    padding: 0px 8px;
    font-size: 12px;
    min-height: 28px;
    max-height: 28px;
    height: 28px;
    min-width: 100px;
    max-width: 125px;
    selection-background-color: {muted_alt};
    selection-color: {primary};
}

QLineEdit#KnownChannelInput:hover {
    border-color: {border_strong};
}

QLineEdit#KnownChannelInput:focus {
    border-color: {muted_foreground};
    background-color: {card};
}

QPushButton#KnownChannelFetchBtn {
    background-color: {primary};
    color: {primary_foreground};
    border: 1px solid transparent;
    border-radius: 6px;
    font-weight: 500;
    font-size: 12px;
    padding: 0px 12px;
    min-height: 28px;
    max-height: 28px;
    height: 28px;
}

QPushButton#KnownChannelFetchBtn:hover {
    background-color: {border_inverse};
}

QPushButton#KnownChannelFetchBtn:pressed {
    background-color: {border_inverse2};
}

QPushButton#KnownChannelFetchBtn:disabled {
    background-color: {muted_alt};
    color: {scrollbar};
    border-color: transparent;
}

QPushButton#ChannelFetchBtn {
    background-color: {popover};
    color: {foreground};
    border: 1px solid {border};
    border-radius: 6px;
    font-size: 12px;
    font-weight: 500;
    padding: 0px 12px;
    min-height: 28px;
    max-height: 28px;
    height: 28px;
}

QPushButton#ChannelFetchBtn:hover {
    background-color: {foreground_inverse};
    color: {card};
    border-color: {foreground_inverse};
}

/* ── Dropdown Selects ────────────────────────────────────────────────────── */

QComboBoxPrivateContainer {
    background-color: transparent;
    border: none;
}

QComboBox {
    background-color: {card};
    border: 1px solid {border};
    border-radius: 6px;
    color: {foreground_inverse};
    padding: 6px 30px 6px 12px;
    font-size: 13px;
    min-height: 24px;
    selection-background-color: {muted_alt};
    selection-color: {primary};
}

QComboBox:hover {
    border-color: {border_strong};
}

QComboBox:focus, QComboBox:on {
    border-color: {muted_fg_static};
    background-color: {card};
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 28px;
    border: none;
    background: transparent;
}

QComboBox::down-arrow {
    image: url("@ICONS_DIR@/chevron_down_gray.png");
    width: 12px;
    height: 12px;
}

QComboBox::down-arrow:hover {
    image: url("@ICONS_DIR@/{icon_chevron}");
}

QComboBox QAbstractItemView {
    background-color: {card};
    border: 1px solid {border};
    border-radius: 6px;
    color: {foreground};
    selection-background-color: {muted_alt};
    selection-color: {primary};
    padding: 4px;
    outline: none;
}

QComboBox QAbstractItemView::item {
    min-height: 28px;
    padding: 4px 10px;
    border-radius: 4px;
    color: {foreground};
}

QComboBox QAbstractItemView::item:hover {
    background-color: {muted};
    color: {primary};
}

QComboBox QAbstractItemView::item:selected {
    background-color: {border};
    color: {primary};
}

/* SpinBox Arrows */
QSpinBox::up-button, QSpinBox::down-button {
    background: transparent;
    border: none;
    width: 16px;
}

/* ── Checkboxes ──────────────────────────────────────────────────────────── */

QCheckBox {
    spacing: 8px;
    font-size: 13px;
    color: {border_muted};
}

QCheckBox:hover {
    color: {primary};
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid {border};
    border-radius: 4px;
    background: {card};
}

QCheckBox::indicator:hover {
    border-color: {scrollbar_hover};
}

QCheckBox::indicator:checked {
    background-color: {primary};
    border: 1px solid {primary};
    image: url("@ICONS_DIR@/{icon_checkbox}");
}

QCheckBox::indicator:checked:hover {
    background-color: {foreground_high};
    border-color: {foreground_high};
}

/* ── Progress Bars ───────────────────────────────────────────────────────── */

QProgressBar {
    background-color: {muted};
    border: 1px solid {border};
    border-radius: 4px;
    color: {foreground};
    font-size: 11px;
    font-weight: 600;
    text-align: center;
    min-height: 10px;
}

QProgressBar::chunk {
    background-color: {primary};
    border-radius: 3px;
}

QProgressBar[state="active"]::chunk {
    background-color: {primary};
}

QProgressBar[state="paused"]::chunk {
    background-color: {scrollbar_pressed};
}

QProgressBar[state="completed"]::chunk {
    background-color: {success};
}

QProgressBar#FileProgressBar {
    background: {muted};
    border: none;
    border-radius: 2px;
    min-height: 4px;
    max-height: 4px;
}

QProgressBar#FileProgressBar[state="idle"]::chunk {
    background: {border_strong};
}

QProgressBar#FileProgressBar[state="active"]::chunk {
    background: {primary};
}

QProgressBar#FileProgressBar[state="completed"]::chunk {
    background: {success};
}

/* ── Download Card Specifics ─────────────────────────────────────────────── */

QFrame#DownloadCardFrame {
    background-color: {card};
    border-radius: 8px;
    border: 1px solid {border};
}

QFrame#DownloadCardFrame:hover {
    border-color: {border_strong};
}

QLabel#MediaTypeBadge {
    background: {muted};
    border: 1px solid {border};
    border-radius: 8px;
    color: {foreground_inverse};
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.05em;
    min-width: 48px;
    min-height: 48px;
    max-width: 48px;
    max-height: 48px;
}

QLabel#CardTitle {
    font-weight: 600;
    font-size: 14px;
    color: {foreground_inverse};
}

QLabel#StatusBadge {
    font-weight: 600;
    font-size: 11px;
    padding: 2px 8px;
    border-radius: 4px;
}

QLabel#StatusBadge[state="active"] {
    color: {warning};
    background: {warning_surface};
    border: 1px solid {warning_border};
}

QLabel#StatusBadge[state="paused"] {
    color: {destructive_solid};
    background: {warning_surface_alt};
    border: 1px solid {destructive_border2};
}

QLabel#StatusBadge[state="completed"] {
    color: {success_fg};
    background: {success_surface};
    border: 1px solid {success_border};
}

QLabel#TypePill {
    background: {muted};
    border: 1px solid {border};
    color: {subtle_foreground};
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 500;
}

QFrame#expandArea {
    background: {card};
    border: 1px solid {border};
    border-top: none;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

QLabel#queueHeader {
    color: {muted_fg_static};
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 2px;
}

QWidget#FileRow {
    border: none;
    border-bottom: 1px solid {muted};
}

QWidget#FileRow[alt="false"] {
    background-color: {card};
}

QWidget#FileRow[alt="true"] {
    background-color: {surface_deep};
}

QLabel#FileRowName {
    font-size: 12px;
    color: {foreground};
}

QLabel#FileRowSize {
    font-size: 11px;
    color: {muted_fg_static};
}

/* ── Dividers ────────────────────────────────────────────────────────────── */

QFrame#DividerHorizontal, QFrame#Divider, QFrame#VercelDivider {
    background-color: {border};
    max-height: 1px;
    height: 1px;
    border: none;
}

/* ── Scrollbars ──────────────────────────────────────────────────────────── */

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0px;
    border: none;
}

QScrollBar::handle:vertical {
    background: {scrollbar_hover};
    border-radius: 5px;
    min-height: 32px;
    margin: 2px 2px 2px 2px;
}

QScrollBar::handle:vertical:hover {
    background: {muted_icon};
}

QScrollBar::handle:vertical:pressed {
    background: {subtle_icon};
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
    width: 0px;
    background: transparent;
    border: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0px;
    border: none;
}

QScrollBar::handle:horizontal {
    background: {scrollbar_hover};
    border-radius: 5px;
    min-width: 32px;
    margin: 2px 2px 2px 2px;
}

QScrollBar::handle:horizontal:hover {
    background: {muted_icon};
}

QScrollBar::handle:horizontal:pressed {
    background: {subtle_icon};
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    height: 0px;
    width: 0px;
    background: transparent;
    border: none;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
}

/* ── File Table ──────────────────────────────────────────────────────────── */

QTableWidget#FileTable {
    background-color: {card};
    border: 1px solid {border};
    border-radius: 8px;
    gridline-color: transparent;
    color: {foreground};
    selection-background-color: {muted};
    selection-color: {primary};
}

QTableWidget#FileTable::item {
    padding: 6px 8px;
    border-bottom: 1px solid {muted};
}

QTableWidget#FileTable QHeaderView::section {
    background-color: {card};
    color: {muted_fg_static};
    font-weight: 600;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border: none;
    border-bottom: 1px solid {border};
    padding: 10px 8px;
}

/* ── Media Browser Dialog & Tabs ─────────────────────────────────────────── */

QDialog {
    background-color: {background};
    color: {foreground};
}

QTabWidget#MediaTabs::pane {
    border: 1px solid {border};
    background: {card};
    border-radius: 8px;
    top: -1px;
}

QTabBar::tab {
    background: {surface_card_text};
    border: 1px solid {border};
    border-bottom: none;
    color: {muted_fg_static};
    padding: 8px 16px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    font-weight: 500;
    font-size: 12px;
    margin-right: 4px;
    margin-top: 4px;
}

QTabBar::tab:selected {
    background: {popover};
    color: {primary};
    border-color: {border_strong};
    margin-top: 0px;
    padding-top: 10px;
}

QTabBar::tab:hover:!selected {
    background: {muted_alt2};
    color: {foreground};
}

/* Selectable List Items in Dialog */
QWidget#SelectableRow {
    background-color: {card};
    border: 1px solid {border};
    border-radius: 8px;
}

QWidget#SelectableRow:hover {
    background-color: {muted};
    border-color: {border_strong};
}

QWidget#SelectableRow[checked="true"] {
    background-color: {muted};
    border: 1px solid {primary};
}

QLabel#MediaItemTitle {
    font-size: 13px;
    font-weight: 600;
    color: {foreground_inverse};
}

QLabel#MediaItemMeta {
    font-size: 11px;
    color: {muted_fg_static};
}

QLabel#SizeBadge {
    background-color: {muted};
    border: 1px solid {border};
    color: {subtle_foreground};
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 11px;
    font-weight: 600;
}

QLabel#DialogStatus {
    color: {success_fg};
    font-weight: 600;
    font-size: 13px;
}

/* Media Grid Items */
QWidget#MediaGridItem {
    background-color: {card};
    border: 1px solid {border};
    border-radius: 8px;
}

QWidget#MediaGridItem:hover {
    border-color: {border_strong};
    background-color: {muted};
}

QWidget#MediaGridItem[checked="true"] {
    border: 1px solid {primary};
    background-color: {muted};
}

QLabel#ThumbnailLabel {
    border-radius: 6px;
    background-color: {muted};
}

QLabel#GridItemTitle {
    font-size: 11px;
    font-weight: 500;
    color: {foreground};
}

QLabel#GridItemSize {
    font-size: 10px;
    color: {muted_fg_static};
}

QLabel#GridItemCheck {
    background-color: {primary};
    color: {primary_foreground};
    border-radius: 8px;
    font-size: 10px;
    font-weight: bold;
    min-width: 18px;
    max-width: 18px;
    min-height: 18px;
    max-height: 18px;
}

QLabel#GridItemCheck[checked="false"] {
    background-color: transparent;
    border: 1px solid {border_strong};
    color: transparent;
}

QPushButton#ViewToggleButton {
    background-color: {card};
    border: 1px solid {border};
    border-radius: 6px;
    color: {subtle_foreground};
    font-size: 12px;
    font-weight: 500;
    padding: 4px 10px;
    min-height: 30px;
}

QPushButton#ViewToggleButton:hover {
    background-color: {muted};
    border-color: {border_strong};
    color: {primary};
}

QPushButton#ViewToggleButton:checked {
    background-color: {primary};
    color: {primary_foreground};
    border-color: {primary};
}

QLineEdit#TelegramSearch {
    background-color: {card};
    border: 1px solid {border};
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 13px;
    color: {foreground_inverse};
}

QLineEdit#TelegramSearch:focus {
    border-color: {muted_fg_static};
    background-color: {card};
}

QFrame#TelegramHeader {
    background-color: {background};
    border-bottom: 1px solid {border};
}

/* ── Login View ──────────────────────────────────────────────────────────── */

QWidget#LoginView {
    background-color: {primary_foreground};
}

QFrame#VercelLoginForm, QFrame#LoginCard {
    background-color: {primary_foreground};
    border: none;
}

QLabel#VercelTitle, QLabel#LoginHeader {
    font-size: 22px;
    font-weight: 600;
    color: {foreground_inverse};
    padding: 2px 0px;
    background: transparent;
}

QLabel#VercelSubtitle, QLabel#LoginSubtitle {
    font-size: 13px;
    font-weight: 400;
    color: {muted_fg_static};
    padding: 4px 0px;
    background: transparent;
}

QLabel#VercelLabel, QLabel#LoginFieldLabel {
    font-size: 11px;
    font-weight: 600;
    color: {subtle_foreground};
    padding: 1px 0px;
    background: transparent;
}

QComboBox#VercelCountryCode {
    background-color: {card};
    border: 1px solid {border};
    border-radius: 6px;
    color: {foreground_inverse};
    padding: 6px 10px;
    font-size: 13px;
}

QComboBox#VercelCountryCode:hover {
    border-color: {border_strong};
}

QComboBox#VercelCountryCode:focus {
    border-color: {muted_fg_static};
    background-color: {card};
}

QLabel#VercelOrBadge {
    color: {muted_fg_static};
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    background: transparent;
}

QLabel#VercelError {
    color: {destructive_const};
    font-size: 12px;
    font-weight: 500;
    padding: 2px 0px;
    background: transparent;
}

QPushButton#VercelBackLink, QPushButton#LoginBackButton {
    background: transparent;
    border: none;
    color: {muted_fg_static};
    font-size: 12px;
    font-weight: 400;
    padding: 4px;
}

QPushButton#VercelBackLink:hover, QPushButton#LoginBackButton:hover {
    color: {foreground_faint};
}

QLabel#VercelFooter, QLabel#LoginHelperLink {
    color: {muted_fg_static};
    font-size: 12px;
}

QLabel#VercelFooter a, QLabel#LoginHelperLink a {
    color: {subtle_border};
    text-decoration: underline;
}

QLabel#VercelFooter a:hover, QLabel#LoginHelperLink a:hover {
    color: {primary};
}

/* ── Clean Status Bar ────────────────────────────────────────────────────── */

QStatusBar {
    background-color: transparent;
    border: none;
    min-height: 0px;
    max-height: 0px;
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    color: transparent;
    font-size: 0px;
}

/* ── Shadcn Phone Input (Light) ──────────────────────────────────────────── */

QPushButton#PhoneCountryButton {
    background-color: {card};
    border: 1px solid {border};
    border-right: none;
    border-top-left-radius: 6px;
    border-bottom-left-radius: 6px;
    border-top-right-radius: 0px;
    border-bottom-right-radius: 0px;
    color: {foreground_inverse};
    font-size: 13px;
    font-weight: 500;
    padding: 0 10px;
    min-height: 40px;
    max-height: 40px;
}

QPushButton#PhoneCountryButton:hover {
    background-color: {muted};
    border-color: {border_strong};
}

QLineEdit#PhoneNumberInput {
    background-color: {card};
    border: 1px solid {border};
    border-top-left-radius: 0px;
    border-bottom-left-radius: 0px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    color: {foreground_inverse};
    font-size: 13px;
    padding: 0 12px;
    min-height: 40px;
    max-height: 40px;
    selection-background-color: {muted_alt};
    selection-color: {primary};
}

QLineEdit#PhoneNumberInput:hover {
    border-color: {border_strong};
}

QLineEdit#PhoneNumberInput:focus {
    border-color: {muted_fg_static};
    background-color: {card};
}

QDialog#CountryPickerPopover {
    background-color: {card};
    border: 1px solid {border};
    border-radius: 8px;
}

QLineEdit#CountrySearchInput {
    background-color: {card};
    border: 1px solid {border};
    border-radius: 6px;
    color: {foreground_inverse};
    font-size: 12px;
    padding: 6px 10px;
    margin: 4px;
}

QLineEdit#CountrySearchInput:focus {
    border-color: {muted_fg_static};
}

QListWidget#CountryList {
    background-color: {card};
    border: none;
    outline: none;
    color: {foreground};
    padding: 2px;
}

QListWidget#CountryList::item {
    padding: 6px 8px;
    border-radius: 4px;
    color: {foreground};
    font-size: 12px;
}

QListWidget#CountryList::item:hover {
    background-color: {muted};
    color: {primary};
}

QListWidget#CountryList::item:selected {
    background-color: {border};
    color: {primary};
}

/* ── Explore Section (Light) ─────────────────────────────────────────────── */

QFrame#ExploreLeftSidebar {
    background-color: {card};
    border-right: 1px solid {border};
}

QListWidget#ExploreChannelList {
    background-color: transparent;
    border: none;
    outline: none;
}

QListWidget#ExploreChannelList::item {
    background-color: transparent;
    border-radius: 8px;
    margin-bottom: 3px;
    border: 1px solid transparent;
}

QListWidget#ExploreChannelList::item:hover {
    background-color: {muted};
}

QListWidget#ExploreChannelList::item:selected {
    background-color: {muted};
    border-color: {border};
}

QFrame#VideoCard {
    background-color: {popover};
    border: 1px solid {border};
    border-radius: 10px;
}

QFrame#VideoCard:hover {
    border-color: {scrollbar};
}

QLabel#VideoCardTitle {
    font-weight: 600;
    font-size: 12px;
    color: {foreground};
    background: transparent;
    border: none;
    padding: 2px 0px;
    line-height: 1.25;
}

QFrame#VideoThumbBox {
    background-color: {static_gray};
    border-radius: 8px;
}



/* ── Custom tool pages (TeleScrap, Auto Message, Auto Transfer, Backup) ──── */

QLabel#PageTitle {
    font-size: 20px;
    font-weight: 700;
    color: {foreground};
}

QLabel#FieldLabel {
    font-size: 11px;
    font-weight: 600;
    color: {foreground};
    background: transparent;
}

QLabel#HelpPoint {
    font-size: 11px;
    color: {muted_foreground};
    background: transparent;
}

QFrame {
    color: {foreground};
}

QListWidget#DestList {
    background-color: {card};
    color: {foreground};
    border: 1px solid {border};
    border-radius: 6px;
    outline: 0;
    font-size: 12px;
    padding: 4px 2px;
}

QListWidget#DestList::item {
    padding: 6px 8px;
    border-radius: 4px;
    color: {foreground};
}

QListWidget#DestList::item:hover {
    background-color: {muted};
}

QListWidget#DestList::item:selected {
    background-color: {accent_soft};
    color: {selected_text};
}

QListWidget#AutoMessageList {
    background-color: transparent;
    border: none;
    outline: 0;
    color: {foreground};
}

QListWidget#AutoMessageList::item {
    padding: 6px 6px;
    border-radius: 6px;
    border-bottom: 1px solid {border};
    color: {foreground};
}

QListWidget#AutoMessageList::item:selected {
    background-color: {accent_soft};
    color: {selected_text};
}

QPlainTextEdit#ConsoleLog {
    background-color: {card};
    color: {foreground};
    border: 1px solid {border};
    border-radius: 6px;
    font-family: Consolas, "SFMono-Regular", monospace;
    font-size: 11px;
    padding: 6px 8px;
}

QLabel#SectionSmall {
    font-size: 14px;
    font-weight: 700;
    color: {foreground};
}

QLabel#LogTitle {
    font-size: 13px;
    font-weight: 700;
    color: {foreground};
}

QPlainTextEdit#ReplyBox {
    background-color: {card};
    color: {foreground};
    border: 1px solid {border};
    border-radius: 6px;
    font-size: 12px;
    padding: 6px 8px;
}

QPlainTextEdit#MessageCompose {
    background-color: {card};
    color: {foreground};
    border: 1px solid {border};
    border-radius: 6px;
    font-size: 12px;
    padding: 6px 8px;
}

QLabel#MsgItemText {
    font-size: 11px;
    color: {foreground};
    background: transparent;
}

QPushButton#MsgCloseButton {
    background: transparent;
    border: none;
    color: #71717A;
    font-size: 13px;
    border-radius: 12px;
}

QPushButton#MsgCloseButton:hover {
    color: #EF4444;
    background-color: rgba(239, 68, 68, 0.12);
}

QRadioButton {
    spacing: 10px;
    font-size: 12px;
    color: {foreground};
    background: transparent;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border-radius: 9px;
    border: 1px solid {border_strong};
    background: {card};
}

QRadioButton::indicator:checked {
    border: 4px solid {border_strong};
    background: {accent};
}

QListWidget#RulesList {
    background-color: transparent;
    border: 1px solid {border};
    border-radius: 6px;
    outline: 0;
    color: {foreground};
}

QListWidget#RulesList::item {
    padding: 8px 10px;
    border-radius: 4px;
    color: {foreground};
    font-size: 12px;
}

QListWidget#RulesList::item:hover {
    background-color: {muted};
}

QListWidget#RulesList::item:selected {
    background-color: {accent_soft};
    color: {selected_text};
}
